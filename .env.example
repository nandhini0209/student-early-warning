# ========================================================
# Student Early Alert & Retention System (SEAS) - Environment Config
# ========================================================

# Server Port (Cloud providers like Render / Railway set PORT automatically)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# --------------------------------------------------------
# MONGODB CONNECTION STRING
# --------------------------------------------------------
# Option A: Local MongoDB (Default for Windows development)
MONGODB_URI=mongodb://127.0.0.1:27017/student_early_alert

# Option B: Cloud MongoDB Atlas (Recommended for Production & Cloud Deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/student_early_alert?retryWrites=true&w=majority

# --------------------------------------------------------
# JSON WEB TOKEN (JWT) SECURITY SECRET
# --------------------------------------------------------
# Use a strong, random 32+ character string in production
JWT_SECRET=early_alert_jwt_secret_key_fsd2_2026_production_secure_token

